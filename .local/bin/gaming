#!/usr/bin/env bash

set -euo pipefail

PI=pi.tail7daaf7.ts.net
HAL9000=hal9000.tail7daaf7.ts.net

created_sessions=()

cleanup() {
  for entry in "${created_sessions[@]}"; do
    server=${entry%%|*}
    session=${entry#*|}
    rex --server "$server" kill "$session" || true
  done
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

ensure_session() {
  server=$1

  if [ -n "${REX_SESSION:-}" ] &&
    rex --server "$server" session inspect "$REX_SESSION" --json >/dev/null 2>&1; then
    session=$REX_SESSION
    return
  fi

  created=$(rex --server "$server" new gaming --json)
  session=$(printf '%s\n' "$created" | jq -er '.session_id')
  created_sessions+=("$server|$session")
}

ensure_session "$PI"
rex --server "$PI" run -s "$session" --wait -- wakeonlan 30:C5:99:25:14:8E

while ! nc -z hal9000 47989; do sleep 1; done

ensure_session "$HAL9000"
rex --server "$HAL9000" run -s "$session" --wait -- sh -c '
  while [ "$(busctl --user get-property \
    org.gnome.Mutter.DisplayConfig \
    /org/gnome/Mutter/DisplayConfig \
    org.gnome.Mutter.DisplayConfig \
    PowerSaveMode)" != "i 0" ]; do
    busctl --user set-property \
      org.gnome.Mutter.DisplayConfig \
      /org/gnome/Mutter/DisplayConfig \
      org.gnome.Mutter.DisplayConfig \
      PowerSaveMode i 0
    sleep 1
  done
'
