#!/bin/sh

set -eu

HOSTNAME="hal9000"
MAC="30:C5:99:25:14:8E"

case "${1:-}" in
pc)
  wakeonlan "$MAC"
  ;;
screen)
  ssh "$HOSTNAME" busctl --user set-property \
    org.gnome.Mutter.DisplayConfig \
    /org/gnome/Mutter/DisplayConfig \
    org.gnome.Mutter.DisplayConfig \
    PowerSaveMode i 0
  ;;
*)
  printf 'Usage: %s {pc|screen}\n' "${0##*/}" >&2
  exit 1
  ;;
esac
